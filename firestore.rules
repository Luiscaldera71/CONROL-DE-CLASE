rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfil de docente: lectura pública permitida para mostrar nombre de la institución y del docente en el portal
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == teacherId;
    }
    
    // Colecciones: courses, students, activities, submissions, attendanceSessions, behaviorRecords, observations
    // Lectura pública para consulta de estudiantes mediante código QR
    // Escritura restringida estrictamente al docente autenticado dueño del registro
    match /{collectionName}/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }
  }
}